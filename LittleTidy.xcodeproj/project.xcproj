{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.0.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Sources/LittleTidy",
      "target-membership": [
        "LittleTidy",
      ],
      "membership-exceptions": [
        {
          "target": "LittleTidy",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Sources/LittleTidyCore", "target-membership": [ "LittleTidyCore" ] },
    { "kind": "folder", "path": "Tests/LittleTidyCoreTests", "target-membership": [ "LittleTidyCoreTests" ] },
    { "kind": "folder", "path": "Sources/LittleTidyQA", "target-membership": [ "LittleTidyQA" ] },
    { "kind": "folder", "path": "Tests/LittleTidyTests", "target-membership": [ "LittleTidyTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/LittleTidy.app", "id": "62130299396E39D7E43F64A8", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/LittleTidyCore.framework",
          "id": "496F231A0B8CAD5D26446F2F",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            "LittleTidy/frameworks",
            { "build-phase": "LittleTidy/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "LittleTidyQA/frameworks",
            "LittleTidyCoreTests/frameworks",
            { "build-phase": "LittleTidyCoreTests/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "LittleTidyTests/frameworks",
            { "build-phase": "LittleTidyTests/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
          ],
        },
        { "path": "<PRODUCTS>/LittleTidyCoreTests.xctest", "id": "D84EC51C7801061F1EB60060", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/LittleTidyQA", "id": "BCA0B63D5A08ECB846E3CF47", "type": "compiled.mach-o.executable", "index": false },
        { "path": "<PRODUCTS>/LittleTidyTests.xctest", "id": "899A443BED8B4FCE5D974639", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "LittleTidyCore",
      "id": "BD27B783873947383E483366",
      "product": "Products/LittleTidyCore.framework",
      "product-type": "framework",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "3VU7K9SUV8",
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "DEFINES_MODULE": "YES",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "ENABLE_MODULE_VERIFIER": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu11 gnu++14",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.federicotrevisani.LittleTidyCore",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "VERSIONING_SYSTEM": "apple-generic",
      },
    }, {
      "name": "LittleTidy",
      "id": "FFEF49DAC23F05349673D82D",
      "product": "Products/LittleTidy.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "3VU7K9SUV8",
      "dependencies": [
        "LittleTidyCore",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Sources/LittleTidy/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.federicotrevisani.LittleTidy",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "NO",
      },
    }, {
      "name": "LittleTidyQA",
      "id": "C113BBBFBDE88E40669A5EF3",
      "product": "Products/LittleTidyQA",
      "product-type": "tool",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "3VU7K9SUV8",
      "dependencies": [
        "LittleTidyCore",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "build-settings": {
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.federicotrevisani.LittleTidyQA",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
      },
    }, {
      "name": "LittleTidyCoreTests",
      "id": "17CCFC3AF1674626E6146823",
      "product": "Products/LittleTidyCoreTests.xctest",
      "product-type": "bundle.unit-test",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "3VU7K9SUV8",
      "dependencies": [
        "LittleTidyCore",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.federicotrevisani.LittleTidyCoreTests",
        "SDKROOT": "macosx",
      },
    }, {
      "name": "LittleTidyTests",
      "id": "32C9593C6422B159849810C8",
      "product": "Products/LittleTidyTests.xctest",
      "product-type": "bundle.unit-test",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "3VU7K9SUV8",
      "dependencies": [
        "LittleTidy",
        "LittleTidyCore",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "COMBINE_HIDPI_IMAGES": "YES",
        "DEAD_CODE_STRIPPING": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.federicotrevisani.LittleTidyTests",
        "SDKROOT": "macosx",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/LittleTidy.app/Contents/MacOS/LittleTidy",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "8",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "3VU7K9SUV8",
    "ENABLE_HARDENED_RUNTIME": "YES",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "MARKETING_VERSION": "0.6.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "macosx",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.2",
}
